# Copy to .env and fill in. Every VITE_* var is inlined into the client
# bundle at build time and is therefore public — never put a secret here.
# The same values need setting in the Netlify dashboard for deploys.

# Supabase — required. Project URL and anon key (Project Settings → API).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google One Tap — optional. OAuth 2.0 Web client ID; without it the
# One Tap prompt is skipped and email OTP sign-in still works.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Web push — optional. Public half of the VAPID key pair (the private half
# lives in the send-push edge function's secrets). Without it, push
# notifications can't be subscribed to.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Giphy — optional. Public, rate-limited API key from
# https://developers.giphy.com. Without it the GIF button is hidden in
# messages and rooms; everything else works.
VITE_GIPHY_API_KEY=your_giphy_api_key
